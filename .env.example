# Copy this to backend/.env and fill values (the backend loads backend/.env).
# Real environment variables override values in that file.

# development | test | production
ENVIRONMENT=development
APP_NAME=AI Software Engineer
APP_VERSION=1.0.0
DEBUG=true
API_PREFIX=/api

# Database - SQLite for quick start, switch to postgres later
DATABASE_URL=sqlite:///./ai_software_engineer.db
# For Postgres: postgresql://user:password@localhost:5432/ai_codebase

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Required, at least 32 characters. This placeholder is for local development only
# and is rejected when ENVIRONMENT=production. Never commit a real value.
SECRET_KEY=dev-secret-key-change-in-production
MAX_UPLOAD_SIZE_MB=100

# OpenAI (Phase 12+)
OPENAI_API_KEY=

# Copy this to backend/.env and fill values (the backend loads backend/.env).
# Real environment variables override values in that file.

# development | test | production
ENVIRONMENT=development
APP_NAME=AI Software Engineer
APP_VERSION=1.0.0
DEBUG=true
API_PREFIX=/api

# Database - PostgreSQL via the async asyncpg driver (postgresql+asyncpg:// is required).
# Must match the POSTGRES_* values below when using docker compose. Placeholder values only.
DATABASE_URL=postgresql+asyncpg://ai_se_dev:change-me-local-dev-only@localhost:5432/ai_software_engineer

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Required, at least 32 characters. This placeholder is for local development only
# and is rejected when ENVIRONMENT=production. Never commit a real value.
SECRET_KEY=dev-secret-key-change-in-production
MAX_UPLOAD_SIZE_MB=100

# JWT access tokens are signed with SECRET_KEY. Algorithm: HS256 | HS384 | HS512.
JWT_ALGORITHM=HS256
# Access-token lifetime in minutes (positive integer). No refresh tokens.
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Repository ZIP ingestion limits (the upload itself is limited by MAX_UPLOAD_SIZE_MB).
# Maximum number of entries in an archive.
MAX_ARCHIVE_FILE_COUNT=10000
# Maximum total uncompressed size of an archive, in MB.
MAX_EXTRACTED_SIZE_MB=500
# Maximum uncompressed size of any single file, in MB (must not exceed MAX_EXTRACTED_SIZE_MB).
MAX_EXTRACTED_FILE_SIZE_MB=25
# Maximum uncompressed/compressed size ratio for any single entry (zip-bomb guard).
MAX_COMPRESSION_RATIO=100
# Background job queue (arq worker). redis:// or rediss://, optional /db index.
# Matches the docker compose "redis" service. Placeholder value only.
REDIS_URL=redis://localhost:6379/0
# Storage for extracted repositories (DATA_DIR/repositories/<repository_id>/).
# Relative paths are resolved against the repository root. Default: <repo>/data
# DATA_DIR=data

# OpenAI (Phase 12+)
OPENAI_API_KEY=

# Anthropic: enables AI file explanations (file contents are sent to Anthropic).
# Leave empty to keep the feature disabled. Never commit a real key.
ANTHROPIC_API_KEY=
# LLM_MODEL=claude-opus-5-5

# --- Docker Compose (local PostgreSQL) ---
# docker compose reads these from the shell or the repository-root .env (not backend/.env).
# Choose your own local password; these are placeholders.
POSTGRES_USER=ai_se_dev
POSTGRES_PASSWORD=change-me-local-dev-only
POSTGRES_DB=ai_software_engineer
POSTGRES_PORT=5432
